{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cau-thang",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": { "enabled": true },
  // Tên miền chính (zone cauthang29.com trên Cloudflare). workers.dev vẫn bật song song.
  "routes": [
    { "pattern": "cauthang29.com", "custom_domain": true },
    { "pattern": "www.cauthang29.com", "custom_domain": true }
  ],
  "workers_dev": true,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "cau-thang-db",
      "database_id": "b34de232-0d58-4ed4-bfa2-e2976f320e44",
      "migrations_dir": "migrations"
    }
  ],
  // Ảnh (WebP/JPEG đã nén ở trình duyệt). Key: img/<id>/<lg|sm>.
  "kv_namespaces": [
    {
      "binding": "MEDIA",
      "id": "3391d9f8a6ac48c2bc122897df9d2bc9"
    }
  ]
}
